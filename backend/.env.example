# ==============================================================================
# EcoBite Backend - Sample environment variables.
# Copy to `.env` and fill in real values. NEVER commit the real `.env` file.
# ==============================================================================

# --- Application ---------------------------------------------------------------
APP_ENV="development"
DEBUG=False
PROJECT_NAME="EcoBite - Smart Meal Management"
API_V1_STR="/api/v1"

# --- Security / JWT -------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY="CHANGE_ME_INSECURE_DEV_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (async driver for the app) ------------------------------------------
# Postgres: postgresql+asyncpg://postgres:postgres_password@localhost:5432/ecobite_db
# Local SQLite fallback: sqlite+aiosqlite:///./ecobite.db
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/ecobite_db"

# --- Redis (Cache & Distributed Locks; redis:7-alpine in docker-compose) -----------
REDIS_URL="redis://localhost:6379/0"
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_LOCK_TIMEOUT_SECONDS=10

# --- CORS --------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (or a JSON array).
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
