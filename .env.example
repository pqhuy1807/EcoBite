# ==============================================================================
# EcoBite Platform - Environment Variables Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Update secrets and custom values for your local or staging environment.
# ==============================================================================

# --- Application Configuration ---
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="EcoBite Platform"
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database (PostgreSQL with PostGIS) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ecobite_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Asynchronous SQLAlchemy connection string used by FastAPI application
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/ecobite_db
# Synchronous connection string used by Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5432/ecobite_db

# --- Redis (Cache, Rate Limiting & PubSub) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Security & JWT Authentication ---
# Minimum 32-character random string for HMAC SHA-256
JWT_SECRET_KEY=ecobite_super_secret_jwt_key_change_me_in_production_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Secret key used for signing time-sensitive HMAC-SHA256 QR order pickup tokens
QR_SIGNATURE_SECRET=ecobite_hmac_secret_for_pickup_qr_tokens_change_in_production
QR_TOKEN_VALIDITY_MINUTES=60

# OAuth2 / Social Login
GOOGLE_CLIENT_ID=your-google-oauth2-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth2-client-secret

# --- Google Gemini GenAI (Free Tier with Google AI Studio / Pro) ---
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash

# --- VNPay Payment Gateway (Sandbox Configuration) ---
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/orders/vnpay-return

# --- Machine Learning Configuration (Local Models) ---
# Relative path from backend/ directory to ml/weights/
ML_WEIGHTS_DIR=../ml/weights
ML_MODEL_FILENAME=food_quality_yolov8.pt
# Inference device: 'cpu', 'cuda' (Nvidia GPU), or 'mps' (Apple Silicon)
ML_DEVICE=cpu
ML_CONFIDENCE_THRESHOLD=0.5
ML_FALLBACK_TO_MOCK=True

# --- Frontend (Next.js Public Variables) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LAT=10.7769
NEXT_PUBLIC_DEFAULT_LNG=106.7009
