# ==============================================================================
# EcoBite Platform - Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Explicitly track template/example env files
!.env.example
!.env.*.example

# ------------------------------------------------------------------------------
# Python & Backend (FastAPI, SQLAlchemy, Alembic)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Type Checking & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# Frontend & Node.js (Next.js, TypeScript, Tailwind)
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store

# Next.js build output
.next/
out/
dist/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# TypeScript declaration cache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Machine Learning (Heavy Model Weights & Datasets)
# ------------------------------------------------------------------------------
# Exclude heavy weights and artifacts
ml/weights/*.pt
ml/weights/*.pth
ml/weights/*.onnx
ml/weights/*.bin
ml/weights/*.tflite
ml/weights/*.engine
ml/weights/*.safetensors
ml/weights/*.tar.gz
ml/weights/*.zip

# Exclude training/raw datasets
ml/datasets/*
ml/runs/
ml/wandb/

# Jupyter Notebook artifacts
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# CRITICAL: Preserve .gitkeep files to maintain directory structure
!.gitkeep
!ml/weights/.gitkeep
!ml/datasets/.gitkeep
!ml/notebooks/.gitkeep

# ------------------------------------------------------------------------------
# Databases & Docker Storage Mounts
# ------------------------------------------------------------------------------
postgres_data/
redis_data/
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# Operating System & IDEs
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# JetBrains IDEs (PyCharm, WebStorm, etc.)
.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim / Emacs temporary files
*~
*.swp
*.swo
